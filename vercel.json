{
  "version": 2,
  "builds": [
    {
      "src": "services/api-gateway/src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["services/api-gateway/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "services/api-gateway/src/index.ts"
    }
  ]
}
