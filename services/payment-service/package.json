{
  "name": "@safiriharaka/payment-service",
  "version": "1.0.0",
  "description": "Safiri Haraka Payment Service — Node.js + TypeScript (wallet, QR, mobile money)",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@safiriharaka/shared-types": "*",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "kafkajs": "^2.2.4",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "@types/node": "^22.5.4",
    "typescript": "^5.5.4",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.13",
    "ts-jest": "^29.2.5",
    "fast-check": "^3.22.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"]
  }
}
