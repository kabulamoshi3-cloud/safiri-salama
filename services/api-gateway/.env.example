# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/dalasmart

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-generate-a-random-64-char-string

# CORS
# Use * for development; set to your frontend URL in production
CORS_ORIGIN=http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# OpenRouteService (optional — falls back to straight-line estimate if absent)
# Get a free key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Redis (optional — not required for basic operation)
REDIS_URL=redis://localhost:6379

# M-Pesa / Vodacom TZ
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/payments/webhook/mpesa

# Airtel Money TZ
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# Tigo Pesa TZ
TIGO_MERCHANT_ACCOUNT=
TIGO_MERCHANT_PIN=
TIGO_SECRET=

# Halotel TZ
HALOTEL_MERCHANT_CODE=
HALOTEL_SECRET=

# Push Notifications (one or both)
EXPO_ACCESS_TOKEN=
FCM_SERVER_KEY=

# SMS / OTP (Africa's Talking)
AT_USERNAME=
AT_API_KEY=

# File Uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Maps (Google Maps API for geocoding, optional)
GOOGLE_MAPS_API_KEY=

# Webhooks (for payment provider callback verification)
WEBHOOK_SECRET=

# Internal Services (optional)
TRACKING_SERVICE_URL=http://localhost:3001
# Shared secret for the tracking-service /api/internal/* endpoints.
# Must match INTERNAL_API_SECRET in tracking-service.  Leave blank in dev to
# skip the check; set a random 32+ char string in production.
INTERNAL_API_SECRET=

# Logging
LOG_LEVEL=info
