# Tracking Service

# Server
TRACKING_PORT=3001

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change-me-generate-a-random-64-char-string

# CORS
CORS_ORIGIN=http://localhost:3000

# Google Maps (optional — for traffic monitoring / route alternatives)
GOOGLE_MAPS_API_KEY=

# Internal API secret — must match INTERNAL_API_SECRET in api-gateway.
# Leave blank in dev to skip the check; set a random 32+ char string in production.
INTERNAL_API_SECRET=
