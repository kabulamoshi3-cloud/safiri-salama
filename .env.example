# DalaSmart API Gateway — Environment Variables
# Copy this file: cp .env.example .env
# Then fill in the values for your environment.
# Lines starting with # are comments and are not loaded.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/dalasmart

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=change-me-generate-a-random-64-char-string

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Use * for development; set to your frontend URL(s) in production
CORS_ORIGIN=http://localhost:3001

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── OpenRouteService (optional) ──────────────────────────────────────────────
# If absent the API falls back to a straight-line distance estimate.
# Get a free key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# ─── Redis (optional) ─────────────────────────────────────────────────────────
# Not required for basic operation; used for optional caching.
REDIS_URL=redis://localhost:6379

# ─── Expo / FCM push notifications ───────────────────────────────────────────
EXPO_ACCESS_TOKEN=
FCM_SERVER_KEY=

# ─── M-Pesa / Vodacom TZ ─────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/payments/webhook/mpesa

# ─── Airtel Money TZ ─────────────────────────────────────────────────────────
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# ─── Tigo Pesa TZ ────────────────────────────────────────────────────────────
TIGO_MERCHANT_ACCOUNT=
TIGO_MERCHANT_PIN=

# ─── Halotel TZ ──────────────────────────────────────────────────────────────
HALOTEL_MERCHANT_CODE=

# ─── Webhook verification ─────────────────────────────────────────────────────
# Shared secret set in each provider's webhook dashboard.
# In production this MUST be set; in dev it is optional (warns if absent).
WEBHOOK_SECRET=

# ─── Mobile app ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
