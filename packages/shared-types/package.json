{
  "name": "@dalasmart/shared-types",
  "version": "1.0.0",
  "description": "Shared TypeScript interfaces and enums for the DalaSmart platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^5.0.10",
    "typescript": "^5.5.4"
  },
  "files": ["dist", "src"]
}
