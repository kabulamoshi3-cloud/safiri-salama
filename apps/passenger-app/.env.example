# Public client endpoints. These values are compiled into the app bundle.
EXPO_PUBLIC_API_URL=https://safiri-salama.vercel.app/api/v1
EXPO_PUBLIC_TRACKING_URL=https://your-tracking-service.example

# Publicly visible in the app binary; restrict this key by application ID,
# bundle ID, and the exact Maps APIs enabled in Google Cloud.
GOOGLE_MAPS_API_KEY=
