{
  "expo": {
    "name": "SkyRex Driver",
    "slug": "skyrex-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2e7d32"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.skyrex.driver"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2e7d32"
      },
      "package": "com.skyrex.driver",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "SkyRex inahitaji mahali pako ili kukusaidia na safari."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2e7d32"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7956fd4b-f540-47d0-90ad-6904eceaaef7"
      }
    }
  }
}
